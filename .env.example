# 复制为 .env 使用
DEEPSEEK_API_KEY=sk-...
# MODEL=deepseek-flash          # 或 deepseek-v4-pro（贵约 4 倍）
# THINKING=disabled             # enabled 开启思考模式：更慢、更贵
# 价格（元/百万 token，默认按高峰价）：PRICE_CACHE_HIT=0.04 PRICE_CACHE_MISS=2 PRICE_OUTPUT=8
# 限制：RATE_PER_HOUR=20 RATE_PER_DAY=60（每个 IP）SITE_PER_HOUR=200（全站）DAILY_BUDGET_CNY=20（全站每天）
# TEMPERATURE=0.3
# 国内构建：
# REGISTRY=docker.1ms.run
# PIP_INDEX=https://mirrors.aliyun.com/pypi/simple
# 记忆：KEEP_MESSAGES=6（原样保留的最近消息数）SUMMARIZE_CHARS=5000（超过就压缩较早的消息）
# 检索：EMBED_MODEL=BAAI/bge-small-zh-v1.5（留空只用关键词检索）MODEL_DIR=models
